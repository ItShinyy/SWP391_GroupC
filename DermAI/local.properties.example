# Copy to DermAI/local.properties (gitignored). Visible in NetBeans.
# This is the ONLY Java secrets file.

APP_ENV=development
APP_BASE_URL=http://localhost:9999/DermAI

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SWP391;encrypt=true;trustServerCertificate=true
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password

GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-client-secret
GOOGLE_REDIRECT_URI=http://localhost:9999/DermAI/auth/google/callback

MAIL_USERNAME=replace-with-sender-address
MAIL_PASSWORD=replace-with-mail-app-password

AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=replace-with-long-random-secret-shared-with-ai-service
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=60000
AI_MAX_RESPONSE_BYTES=15728640

HARD_MAX_UPLOAD_BYTES=10485760
HARD_MAX_IMAGE_WIDTH=8192
HARD_MAX_IMAGE_HEIGHT=8192
HARD_MAX_IMAGE_PIXELS=32000000

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
MEDIA_DIAGNOSIS_PREFIX=diagnoses/v1
MEDIA_SIGNED_URL_TTL_SECONDS=600
MEDIA_OBJECT_KEY_SECRET=replace-with-a-long-random-server-only-secret

AI_SCREENING_MAX_REQUESTS_PER_WINDOW=3
AI_SCREENING_RATE_WINDOW_SECONDS=60
AI_PROCESSING_TIMEOUT_MINUTES=10
AI_RECOVERY_INTERVAL_MINUTES=5
ORPHAN_MINIMUM_AGE_HOURS=24

# Host folder with active/ package (model.onnx, labels.json, reference_features.npz, metadata.json).
# Same path as AI_MODELS_ROOT in DermAI/ai-service/.env.local when running uvicorn on the host.
AI_MODELS_ROOT=C:/Users/phong/Downloads/SWP391/DermAI-private-artifacts

# Billing — Java owns invoices; Node payment-service owns VNPay.
# Behind Nginx :80 use PAYMENT_API_BASE_URL=http://localhost
# Direct Node (no Nginx): PAYMENT_API_BASE_URL=http://localhost:3000
BILLING_DEFAULT_CONSULTATION_FEE=200000
PAYMENT_API_BASE_URL=http://localhost
PAYMENT_EXPIRE_MINUTES=4
NOTIFICATION_DRAIN_INTERVAL_MINUTES=1

# VNPay secrets: DermAI/payment-service/.env.local (never commit)
# APP_BASE_URL / GOOGLE_REDIRECT_URI should match Nginx UI base when using port 80:
# APP_BASE_URL=http://localhost/DermAI
# GOOGLE_REDIRECT_URI=http://localhost/DermAI/auth/google/callback
