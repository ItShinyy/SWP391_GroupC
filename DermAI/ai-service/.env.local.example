# Copy to .env.local (gitignored). FastAPI secrets only — no DB/Cloudinary.
# AI_SERVICE_API_KEY must match SkinAI/local.properties.

AI_SERVICE_API_KEY=replace-with-long-random-secret-shared-only-with-java
AI_MAX_INPUT_BYTES=10485760
HARD_MAX_AI_CONCURRENCY=4

# Host path (recommended for local uvicorn). Same folder as Java AI_MODELS_ROOT.
AI_MODELS_ROOT=C:/Users/phong/Downloads/SWP391/DermAI-private-artifacts

# Docker-only alternative: AI_MODELS_ROOT=/artifacts/models with a bind mount of the host folder.
