# Node.js payment API
PORT=3000

# SQL Server (database created by ClinicLocate/database scripts)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=SWP391
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# VNPay Sandbox / production credentials. Keep real values out of Git.
VNP_TMN_CODE=your-vnpay-tmn-code
VNP_HASH_SECRET=your-vnpay-hash-secret
VNP_HOST=https://sandbox.vnpayment.vn
VNP_TEST_MODE=true

# URLs routed by Nginx. IPN needs a public HTTPS URL for actual VNPay callbacks.
VNP_RETURN_URL=http://localhost/payments/vnpay/return
APP_UI_BASE_URL=http://localhost/Invoices

# true is for standalone local testing. Integrate the parent application's
# verified session/JWT before using this service in production.
PAYMENT_DEMO_MODE=true
