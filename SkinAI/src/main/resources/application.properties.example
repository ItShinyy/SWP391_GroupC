# Copy this file to application.properties and replace every placeholder.
# Never commit application.properties because it contains credentials.

# SQL Server
db.url=jdbc:sqlserver://localhost:1433;databaseName=SWP391;encrypt=true;trustServerCertificate=true
db.username=sa
db.password=change-me
db.driver=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Google OAuth2 (optional for local login; leave blank if not configured)
google.client.id=your-google-client-id
google.client.secret=your-google-client-secret
google.redirect.uri=http://localhost:8080/SkinAI/auth/google/callback
google.auth.url=https://accounts.google.com/o/oauth2/v2/auth
google.token.url=https://oauth2.googleapis.com/token
google.userinfo.url=https://www.googleapis.com/oauth2/v3/userinfo
google.scope=openid email profile

# AI service (mock mode works without a separate AI service)
ai.service.url=http://localhost:5000/api/predict
ai.service.timeout=30000
ai.service.enabled=false
ai.mock.enabled=true

# File upload
firebase.enabled=false
firebase.bucket=
firebase.credentials.path=/WEB-INF/firebase-credentials.json
storage.local.enabled=true
storage.local.upload.dir=uploads
storage.local.max.file.size=10485760
upload.allowed.extensions=jpg,jpeg,png
upload.max.size.bytes=10485760

# Application
app.name=SkinAI
app.version=1.0
app.base.url=http://localhost:8080/SkinAI

# SMTP (leave blank to disable real outgoing mail during local development)
mail.username=
mail.password=
